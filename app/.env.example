POSTGRES_PASSWORD=change-me
POSTGRES_USER=opt_catalog
POSTGRES_DB=opt_catalog
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
LOG_LEVEL=INFO

# Бот-токены НЕ здесь — у каждого оптовика свой бот, токен лежит в БД у тенанта
# (python -m app.cli create-tenant/set-bot). initData проверяется токеном тенанта.
INIT_DATA_MAX_AGE_SEC=86400

# true — принимать X-Tg-User-Id без проверки подписи (работа в браузере).
# НА ПРОДЕ ТОЛЬКО false.
DEV_AUTH=false

# Адрес Bot API для уведомлений. С прода api.telegram.org недоступен — как в такси,
# можно указать прокси-воркер Cloudflare.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Домен мини-аппа — для кнопок «Открыть» под уведомлениями (/t/{slug}/...)
WEBAPP_BASE_URL=

# Ключ бот-сервиса для /v1/service/* (X-Service-Key). Пусто — ручки выключены.
SERVICE_API_KEY=

UPLOADS_DIR=/app/uploads

# Владелец платформы: Telegram id суперадминов через запятую — им доступен
# раздел «Платформа» (заведение оптовиков). Через API их не назначить.
PLATFORM_ADMIN_IDS=
# Необязательный «бот платформы»: его мини-апп открывает /platform
PLATFORM_BOT_TOKEN=
